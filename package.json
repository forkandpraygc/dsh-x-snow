{
  "name": "@local/dsh-x-snow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-screen XSnow-style falling snow for DeepSeek Harness.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "preview/*.gif",
    "preview/*.png",
    "preview/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
